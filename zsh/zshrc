# ~/.zshrc — interactive shell config. Rosé Pine Moon everything.

# ---- history ---------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# ---- behaviour -------------------------------------------------------------
setopt AUTO_CD            # `..` or a dir name cd's there
setopt CORRECT            # "did you mean?" for typo'd commands
setopt NO_BEEP
bindkey -e                # emacs-style line editing (Ctrl-A/E, etc.)
bindkey '^[[A' history-search-backward   # Up arrow searches history by prefix
bindkey '^[[B' history-search-forward

# ---- completion ------------------------------------------------------------
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ---- environment -----------------------------------------------------------
export EDITOR=nvim
export VISUAL=nvim
export BAT_THEME="Catppuccin Mocha"
export FZF_DEFAULT_OPTS="
  --color=fg:#a6adc8,bg:#1e1e2e,hl:#fab387
  --color=fg+:#cdd6f4,bg+:#313244,hl+:#fab387
  --color=border:#45475a,header:#89b4fa,gutter:#1e1e2e
  --color=spinner:#f9e2af,info:#94e2d5
  --color=pointer:#cba6f7,marker:#f38ba8,prompt:#cba6f7"

# ---- aliases ---------------------------------------------------------------
command -v eza  >/dev/null && { alias ls='eza --icons'; alias ll='eza --icons -la'; alias lt='eza --icons --tree --level=2'; } || alias ll='ls -la'
command -v bat  >/dev/null && alias cat='bat'
command -v nvim >/dev/null && { alias vim='nvim'; alias vi='nvim'; }
command -v btop >/dev/null && alias top='btop'
command -v lazygit >/dev/null && alias lg='lazygit'
alias caff='caffeinate -i -d'   # keep mac awake (Ctrl-C to stop)
alias tn="ssh -t north 'tmux new -A -s main'"   # north, straight into tmux
y() {  # yazi, and cd to wherever you ended up
  local tmp; tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  yazi "$@" --cwd-file="$tmp"
  local cwd; cwd="$(cat -- "$tmp")" && rm -f -- "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
}
alias zshrc='nvim ~/Projects/dotfiles/zsh/zshrc && source ~/.zshrc'

# fun stuff / project launchers
alias radio="python3 ~/Projects/radiooooo/radio.py"
alias menu='bash ~/ClawdbotSync/terminal-menu/menu.sh'
qwen() { cd ~/Projects/qwen-agent && npm run dev; }

# ---- tools -----------------------------------------------------------------
BREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
[ -f "$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh" ] && source "$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
[ -f "$BREW_PREFIX/opt/fzf/shell/completion.zsh" ]   && source "$BREW_PREFIX/opt/fzf/shell/completion.zsh"
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"     # `z dir` — smarter cd
command -v atuin    >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"   # Ctrl-R = history search
command -v starship >/dev/null && eval "$(starship init zsh)"

# plugins (must be last; syntax-highlighting must be the very last)
for p in zsh-autosuggestions zsh-syntax-highlighting; do
  for d in "$BREW_PREFIX/share/$p" "$HOME/.local/share/$p"; do
    [ -f "$d/$p.zsh" ] && { source "$d/$p.zsh"; break; }
  done
done
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086'

# machine-local overrides (secrets, one-off paths) — not tracked in git
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# greeting (only in a fresh top-level terminal, not inside tmux/vim/etc.)
if [[ -o interactive && -z "$TMUX" && -z "$NVIM" && $SHLVL -eq 1 ]] && command -v fastfetch >/dev/null; then
  if [ "$(tput cols 2>/dev/null || echo 80)" -ge 100 ]; then
    fastfetch
  else
    fastfetch --logo apple_small --logo-padding-right 2
  fi
fi
