#!/usr/bin/env bash
# Tidy ~/Downloads. Runs hourly via launchd (see mac/launchd). Safe to run by hand.
#   - PDFs            -> ~/Literature/inbox
#   - zips already extracted next to them -> Trash
#   - anything untouched for 30+ days      -> ~/Archive/downloads/YYYY-MM
# Skips files modified in the last 10 minutes (may still be downloading).
set -euo pipefail
DL="$HOME/Downloads"; LIT="$HOME/Literature/inbox"; ARC="$HOME/Archive/downloads"
LOG="$HOME/Library/Logs/tidy-downloads.log"
mkdir -p "$LIT" "$ARC"
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }
trash() { mv "$1" "$HOME/.Trash/" 2>/dev/null || rm -f "$1"; }
shopt -s nullglob nocaseglob

cd "$DL"
for f in *; do
  [ -e "$f" ] || continue
  [[ "$f" == .* ]] && continue
  [[ "$f" == *.crdownload || "$f" == *.download || "$f" == *.part ]] && continue
  # still being written?
  if [ -n "$(find "$f" -maxdepth 0 -mmin -10)" ]; then continue; fi

  case "$f" in
    *.pdf)
      dest="$LIT/$f"; [ -e "$dest" ] && dest="$LIT/${f%.pdf}-$(date +%s).pdf"
      mv "$f" "$dest"; log "pdf   -> $dest"; continue ;;
    *.zip)
      base="${f%.zip}"
      if [ -d "$base" ]; then trash "$f"; log "zip   -> trash (extracted: $base)"; continue; fi ;;
  esac

  # older than 30 days (by modification time) -> archive by month
  if [ -n "$(find "$f" -maxdepth 0 -mtime +30)" ]; then
    month="$(date -r "$f" +%Y-%m)"; mkdir -p "$ARC/$month"
    mv "$f" "$ARC/$month/"; log "old   -> $ARC/$month/$f"
  fi
done
