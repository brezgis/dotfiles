{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logos/cat.txt",
    "type": "file",
    "color": { "1": "magenta", "2": "blue", "3": "yellow", "4": "green" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": { "separator": " " },
  "modules": [
    { "type": "custom", "format": "{#35}╭──────────────────────────────╮" },
    { "type": "title",  "format": "{#35}│{#}  {user-name-colored}{at-symbol-colored}{host-name-colored}", "color": { "user": "magenta", "at": "white", "host": "blue" } },
    { "type": "custom", "format": "{#35}├──────────────────────────────┤" },
    { "type": "os",      "key": "{#35}│{#}   ", "format": "{name} {codename} {version}" },
    { "type": "host",    "key": "{#35}│{#}  󰌢 " },
    { "type": "uptime",  "key": "{#35}│{#}   " },
    { "type": "shell",   "key": "{#35}│{#}   " },
    { "type": "memory",  "key": "{#35}│{#}   " },
    { "type": "disk",    "key": "{#35}│{#}  󰋊 ", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "cpu",     "key": "{#35}│{#}   " },
    { "type": "gpu",     "key": "{#35}│{#}  󰢮 ", "format": "{name}" },
    { "type": "loadavg", "key": "{#35}│{#}  󰓅 " },
    { "type": "custom", "format": "{#35}╰──────────────────────────────╯" }
  ]
}
