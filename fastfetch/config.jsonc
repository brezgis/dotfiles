{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "macos", "padding": { "top": 1, "left": 2, "right": 4 } },
  "display": { "separator": ": ", "key": { "type": "string" } },
  "modules": [
    { "type": "title", "color": { "user": "magenta", "at": "white", "host": "blue" } },
    { "type": "separator", "string": "─", "length": 22 },
    { "type": "os",       "key": "OS",       "keyColor": "magenta", "format": "{name} {codename} {version} {arch}" },
    { "type": "host",     "key": "Host",     "keyColor": "magenta" },
    { "type": "kernel",   "key": "Kernel",   "keyColor": "magenta" },
    { "type": "uptime",   "key": "Uptime",   "keyColor": "magenta" },
    { "type": "packages", "key": "Packages", "keyColor": "magenta" },
    { "type": "shell",    "key": "Shell",    "keyColor": "magenta" },
    { "type": "display",  "key": "Display",  "keyColor": "magenta", "compactType": "original" },
    { "type": "terminal", "key": "Terminal", "keyColor": "magenta" },
    { "type": "cpu",      "key": "CPU",      "keyColor": "magenta" },
    { "type": "gpu",      "key": "GPU",      "keyColor": "magenta", "hideType": "none" },
    { "type": "memory",   "key": "Memory",   "keyColor": "magenta" },
    { "type": "disk",     "key": "Disk",     "keyColor": "magenta", "folders": "/" },
    { "type": "battery",  "key": "Battery",  "keyColor": "magenta" },
    { "type": "localip",  "key": "Local IP", "keyColor": "magenta", "showIpv6": false, "compact": true },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 0 }
  ]
}
