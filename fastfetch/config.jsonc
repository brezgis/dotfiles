{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": { "separator": "  ", "color": { "title": "magenta" } },
  "modules": [
    { "type": "title", "color": { "user": "magenta", "at": "white", "host": "blue" } },
    { "type": "custom", "format": "{#35}────────────────────────────────────" },
    { "type": "os",       "key": "  os",      "keyColor": "magenta" },
    { "type": "host",     "key": "󰌢  machine", "keyColor": "magenta" },
    { "type": "kernel",   "key": "  kernel",  "keyColor": "yellow" },
    { "type": "uptime",   "key": "  up",      "keyColor": "yellow" },
    { "type": "packages", "key": "  pkgs",    "keyColor": "green" },
    { "type": "shell",    "key": "  shell",   "keyColor": "green" },
    { "type": "terminal", "key": "  term",    "keyColor": "cyan" },
    { "type": "terminalfont", "key": "  font", "keyColor": "cyan" },
    { "type": "cpu",      "key": "  cpu",     "keyColor": "blue" },
    { "type": "gpu",      "key": "󰢮  gpu",     "keyColor": "blue" },
    { "type": "memory",   "key": "  memory",  "keyColor": "red" },
    { "type": "disk",     "key": "󰋊  disk",    "keyColor": "red", "folders": "/" },
    { "type": "battery",  "key": "  battery", "keyColor": "red" },
    { "type": "localip",  "key": "󰩟  ip",      "keyColor": "white", "showIpv6": false, "compact": true },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
