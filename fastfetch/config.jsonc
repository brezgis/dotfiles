{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": { "separator": "  ", "color": { "keys": "magenta", "title": "magenta" } },
  "modules": [
    "title",
    { "type": "custom", "format": "{#35}───────────────────────────────" },
    { "type": "os",      "key": "  os",     "keyColor": "magenta" },
    { "type": "host",    "key": "󰌢  host",   "keyColor": "yellow" },
    { "type": "kernel",  "key": "  kernel", "keyColor": "yellow" },
    { "type": "uptime",  "key": "  uptime", "keyColor": "cyan" },
    { "type": "shell",   "key": "  shell",  "keyColor": "cyan" },
    { "type": "terminal","key": "  term",   "keyColor": "blue" },
    { "type": "cpu",     "key": "  cpu",    "keyColor": "blue" },
    { "type": "memory",  "key": "  memory", "keyColor": "red" },
    { "type": "disk",    "key": "󰋊  disk",   "keyColor": "red" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 2 }
  ]
}
