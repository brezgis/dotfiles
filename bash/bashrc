# bash config for machines without zsh (north, samovar). Interactive shells only.
case $- in *i*) ;; *) return ;; esac
export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim VISUAL=nvim
export BAT_THEME="Catppuccin Mocha"
export FZF_DEFAULT_OPTS="
  --color=fg:#cdd6f4,bg:#1e1e2e,hl:#f38ba8 --color=fg+:#cdd6f4,bg+:#313244,hl+:#f38ba8
  --color=info:#cba6f7,prompt:#cba6f7,pointer:#f5e0dc,marker:#b4befe,spinner:#f5e0dc,header:#f38ba8"
HISTSIZE=50000; HISTFILESIZE=50000; HISTCONTROL=ignoreboth; shopt -s histappend
bind '"\e[A": history-search-backward' 2>/dev/null
bind '"\e[B": history-search-forward'  2>/dev/null

command -v eza  >/dev/null && { alias ls='eza --icons'; alias ll='eza --icons -la'; alias lt='eza --icons --tree --level=2'; }
command -v bat  >/dev/null && alias cat='bat'
command -v nvim >/dev/null && { alias vim='nvim'; alias vi='nvim'; }
command -v btop >/dev/null && alias top='btop'
command -v lazygit >/dev/null && alias lg='lazygit'
y() { local tmp; tmp="$(mktemp -t yazi-cwd.XXXXXX)"; yazi "$@" --cwd-file="$tmp"
      local cwd; cwd="$(cat -- "$tmp")" && rm -f -- "$tmp"; [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"; }

[ -f "$HOME/.fzf.bash" ] && source "$HOME/.fzf.bash"
command -v zoxide   >/dev/null && eval "$(zoxide init bash)"
command -v atuin    >/dev/null && eval "$(atuin init bash --disable-up-arrow)"   # Ctrl-R = history search
command -v starship >/dev/null && eval "$(starship init bash)"
[ -f "$HOME/.bashrc.local" ] && source "$HOME/.bashrc.local"

# greeting (fresh top-level shell only); servers get the cpu/gpu card
if [ -z "$TMUX" ] && [ "$SHLVL" -le 2 ] && command -v fastfetch >/dev/null; then
  if [ "$(tput cols 2>/dev/null || echo 80)" -ge 100 ]; then
    fastfetch -c ~/.config/fastfetch/server.jsonc
  else
    fastfetch -c ~/.config/fastfetch/server.jsonc --logo ubuntu_small --logo-padding-right 2
  fi
fi

